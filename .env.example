# libSQL connection. A local file is enough for development.
# Production should be a Turso URL: libsql://<db>-<org>.turso.io
NUXT_TURSO_DATABASE_URL=file:./data/local.db

# Required for remote Turso. Leave empty for a local file.
NUXT_TURSO_AUTH_TOKEN=

# Seals the admin session cookie. At least 32 characters.
# Development generates one into .env on first `pnpm dev` when this is empty.
NUXT_SESSION_PASSWORD=

# scrypt hash of the shared editor password. Generate with:
#   ADMIN_PASSWORD='your-password' pnpm auth:hash
NUXT_ADMIN_PASSWORD_HASH=
